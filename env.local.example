# Grove — Environment Variables
# Copy this to .env.local and fill in your values.
# Without these, the app runs in demo mode using dummy data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI classification (at least one required for branch auto-classification)
# Get yours at https://console.anthropic.com or https://platform.openai.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
